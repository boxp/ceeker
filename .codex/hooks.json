{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/lint_format_check_hook.py\"",
            "statusMessage": "Running ceeker format-check and lint",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
